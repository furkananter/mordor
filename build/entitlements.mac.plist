<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Entitlements applied to the app (and, via entitlementsInherit, its helper
    processes) when building under the hardened runtime, which Apple requires
    for notarization.

    - allow-jit / allow-unsigned-executable-memory: V8 JITs JavaScript, so it
      needs writable+executable memory the hardened runtime would otherwise deny.
    - disable-library-validation: lets the app load native modules (keytar,
      node-pty) whose .node binaries aren't signed by our Team ID.
    - allow-dyld-environment-variables: some Electron/native tooling relies on
      DYLD_* at launch; harmless to permit and avoids notarization surprises.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
